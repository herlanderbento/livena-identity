{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Console": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "FormatterName": "json",
    "FormatterOptions": {
      "SingleLine": true,
      "IncludeScopes": true,
      "TimestampFormat": "HH:mm:ss ",
      "UseUtcTimestamp": true,
      "JsonWriterOptions": {
        "Indented": false
      }
    }
  },
  "ConnectionStrings": {
    "IdentityDb":"Host=#DB_HOST#;Port=#DB_PORT#;Database=#DB_NAME#;Username=#DB_USER#;Password=#DB_PASSWORD#;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=100;"
  }
}
